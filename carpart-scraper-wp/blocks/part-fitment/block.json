{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "csf-parts/part-fitment",
	"title": "CSF Part Fitment",
	"category": "csf-parts",
	"icon": "car",
	"description": "Fits these vehicles: make, model, years, engine and notes.",
	"keywords": [
		"part",
		"fitment",
		"vehicles",
		"compatibility"
	],
	"usesContext": [],
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"showSummary": {
			"type": "boolean",
			"default": true
		},
		"layout": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"table",
				"cards"
			]
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "file:../build/part-blocks/index.js",
	"style": "csf-part-modern",
	"render": "file:./render.php"
}
