{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "csf-parts/part-gallery",
	"title": "CSF Part Gallery",
	"category": "csf-parts",
	"icon": "format-gallery",
	"description": "Main image with thumbnails.",
	"keywords": [
		"part",
		"gallery",
		"images"
	],
	"usesContext": [],
	"attributes": {
		"showThumbnails": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true
		}
	},
	"editorScript": "file:../build/part-blocks/index.js",
	"style": "csf-part-modern",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
