{
  "name": "csf-parts-catalog",
  "version": "1.0.0",
  "description": "WordPress plugin for CSF MyCarParts automotive parts catalog with Gutenberg blocks and async search",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "format": "wp-scripts format",
    "test:a11y": "pa11y-ci",
    "test:a11y:verbose": "pa11y-ci --reporter cli",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:inspect": "playwright test --grep 'Inspect current'",
    "test:e2e:setup-colors": "playwright test --grep 'Setup Kadence'",
    "packages-update": "wp-scripts packages-update"
  },
  "keywords": [
    "wordpress",
    "gutenberg",
    "blocks",
    "automotive",
    "parts",
    "catalog"
  ],
  "author": "Development Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@wordpress/block-editor": "^18.0.0",
    "@wordpress/blocks": "^16.1.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/scripts": "^36.0.0",
    "@wordpress/server-side-render": "^6.32.0",
    "pa11y": "^10.0.0",
    "pa11y-ci": "^4.1.1"
  }
}
